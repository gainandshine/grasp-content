{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topic",
  "type": "object",
  "required": ["id", "name", "topicId", "content"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "topicId": { "type": "string", "description": "Primary topic ID for this topic" },
    "description": { "type": "string" },
    "content": {
      "type": "object",
      "required": ["overview", "explanation", "keyPoints", "whyItMatters"],
      "properties": {
        "overview": { "type": "string" },
        "explanation": { "type": "string" },
        "keyPoints": { "type": "array", "items": { "type": "string" } },
        "whyItMatters": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "order": { "type": "integer" },
        "estimatedMinutes": { "type": "number" },
        "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] }
      }
    }
  }
}
