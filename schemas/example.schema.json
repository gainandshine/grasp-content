{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Examples",
  "type": "object",
  "required": ["examples"],
  "properties": {
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "content"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "content": { "type": "string" },
          "source": { "type": "string" },
          "difficulty": { "type": "string" },
          "estimatedMinutes": { "type": "number" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
