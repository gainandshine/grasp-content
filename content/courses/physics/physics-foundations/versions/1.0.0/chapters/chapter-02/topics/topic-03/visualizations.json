    {
      "id": "formula-01",
      "type": "formula",
      "title": "Unit Conversion Formula",
      "description": "Mathematical definition",
      "spec": {
        "main_latex": "v_{km/h} = v_{m/s} \\times 3.6",
        "steps": [
          {
            "latex": "3.6 = \\dfrac{1\\ \\text{km}}{1000\\ \\text{m}} \\times \\dfrac{3600\\ \\text{s}}{1\\ \\text{h}}",
            "explanation": "The 3.6 comes straight from the conversion factors for distance (m to km) and time (s to h) multiplied together."
          }
        ]
      }
    },
    {
      "id": "3d-01",
      "type": "3d",
      "title": "Unit Conversion 3D Model",
      "description": "Interactive 3D visualization",
      "spec": {
        "setup_code": "var geometry = new api.THREE.BoxGeometry(1, 1, 1);\n                var material = new api.THREE.MeshPhongMaterial({ color: 0xE8593C });\n                var cube = new api.THREE.Mesh(geometry, material);\n                api.group.add(cube);\n                return {\n                  update: function(t) {\n                    cube.rotation.x = t * 0.02;\n                    cube.rotation.y = t * 0.03;\n                  }\n                };"
      }
    },
    {
      "id": "anim-01",
      "type": "2d-anim",
      "title": "Unit Conversion Animation",
      "description": "Canvas animation",
      "spec": {
        "setup_code": "return {\n                  draw: function(ctx, W, H, t, dt) {\n                    ctx.fillStyle = '#F5F0E8';\n                    ctx.fillRect(0, 0, W, H);\n                    var x = W/2 + Math.sin(t * 0.05) * 100;\n                    var y = H/2 + Math.cos(t * 0.05) * 100;\n                    ctx.fillStyle = '#E8593C';\n                    ctx.beginPath();\n                    ctx.arc(x, y, 20, 0, Math.PI * 2);\n                    ctx.fill();\n                  }\n                };"
      }
    },
